\ProvidesPackage{preamble}[2026/09/06 ARTEMIS findings report preamble]

% ---- Page geometry --------------------------------------------------------
\RequirePackage[a4paper,top=0.92in,bottom=0.92in,left=0.95in,right=0.95in]{geometry}

% ---- Fonts: Times Roman body and matching math --------------------------
\RequirePackage{newtxtext}
\RequirePackage{newtxmath}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{microtype}

% ---- Core packages ------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{csquotes}
\RequirePackage[labelfont=bf,font=small,skip=4pt]{caption}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{mdframed}
\RequirePackage[hidelinks]{hyperref}

% ---- Colours ----------------------------------------------------------
\definecolor{artemisink}{HTML}{1B1B1B}
\definecolor{artemisblue}{HTML}{356FB0}
\definecolor{artemisrule}{HTML}{9AB2CC}
\definecolor{artemisbg}{HTML}{EEF3F8}

% ---- Graphics path --------------------------------------------------------
\graphicspath{{figures/}}

% ---- List spacing -------------------------------------------------------
\setlist{itemsep=2pt,topsep=3pt,parsep=0pt}
\setlist[enumerate]{leftmargin=1.6em}
\setlist[itemize]{leftmargin=1.4em}

% ---- Heading styles ---------------------------------------------------
\titleformat{\section}{\normalfont\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{3pt}

% ---- Header / footer -------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small ARTEMIS Foundational Research}
\fancyhead[R]{\small Findings and Synthesis}
\fancyfoot[C]{\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\small\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
}

% ---- Finding callout box ----------------------------------------------
\newcounter{finding}
\renewcommand{\thefinding}{F\arabic{finding}}
\newmdenv[
  linewidth=0.8pt,
  linecolor=artemisrule,
  backgroundcolor=artemisbg,
  topline=true,bottomline=true,leftline=true,rightline=true,
  innertopmargin=6pt,innerbottommargin=6pt,
  innerleftmargin=8pt,innerrightmargin=8pt,
  skipabove=8pt,skipbelow=8pt,
]{findingframe}

\newenvironment{finding}[1][]{%
  \refstepcounter{finding}%
  \begin{findingframe}%
  \noindent\textbf{Finding \thefinding.}\enspace \textit{#1}\par\vspace{2pt}%
}{%
  \end{findingframe}%
}

% ---- Convenience -----------------------------------------------------
\newcommand{\pctsym}{\%}
\renewcommand{\arraystretch}{1.15}
